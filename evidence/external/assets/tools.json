        "raw": "ramulator2.raw.json",
        "expected": "ramulator2.expected.json"
      },
      "facets": [
        {
          "id": "dram.read-byte-accounting",
          "claim": "Exact burst-rounded read/write byte accounting for three single-bank DDR4 traces; no HBM timing or row-state equivalence claim.",
          "shared_boundary": [
            "one channel, rank, bank group, and bank",
            "64-byte read transactions",
            "identical address and request-byte census"
          ],
          "excluded": [
            "aggregate HBM access latency and effective bandwidth versus command-level DRAM service span",
            "row-state classification, bank scheduling, and refresh",
            "write timing and read/write turnaround",
            "multi-bank, multi-rank, and multi-channel scheduling",
            "HBM pseudo-channel topology and HBFSim address swizzle",
            "queue saturation, backpressure, and starvation policy"
          ],
          "cases": [
            "l3.ramulator2.read-miss",
            "l3.ramulator2.read-hit",
            "l3.ramulator2.read-conflict"
          ]
        }
      ],
      "cases": [
        {
          "case_id": "l3.ramulator2.read-miss",
          "facet_id": "dram.read-byte-accounting",
          "hbfsim_case": "verification/cases/l3.ramulator2.read-miss.json",
          "external_inputs": {
            "config": "evidence/external/assets/ramulator2-ddr4-3200w.yaml",
            "trace": "evidence/external/assets/traces/ramulator2-read-miss.trace"
          },
          "shared_metrics": [
            "read_bytes",
            "write_bytes"
          ],
          "hbfsim_metrics": {
            "read_bytes": "read_bytes",
            "write_bytes": "write_bytes"
