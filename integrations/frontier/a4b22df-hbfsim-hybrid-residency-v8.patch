+def test_hybrid_residency_grid_conserves_unique_hbm_and_backing_bytes() -> None:
+    replica_config = ReplicaConfig(
+        model_name="llama31_70b",
+        memory_precision_profile="w8a16-kv-bf16",
+        device="h20",
+        attn_tensor_parallel_size=1,
+        moe_tensor_parallel_size=1,
+        moe_expert_parallel_size=1,
+        num_pipeline_stages=1,
+        memory_margin_fraction=0.0,
+    )
+    planner = MemoryPlanner(
+        replica_config=replica_config,
+        replica=SimpleNamespace(
+            total_memory_gb=96,
+            memory_margin_fraction=0.0,
+            max_request_tokens=131_072,
+            kv_heads_per_tensor_parallel_worker=8,
+            attention_head_dim=128,
+            num_layers=80,
+        ),
+        cluster_type=ClusterType.MONOLITHIC,
+    )
+    for capacity_gib in (96, 192, 288, 384):
+        for target in (0.75, 1.0, 1.25, 1.5, 2.0):
+            if capacity_gib == 96 and target == 0.75:
+                with pytest.raises(
+                    FrontierMemoryOOMError,
+                    match="cannot contain immutable weights",
+                ):
+                    planner.get_hybrid_residency_plan(
+                        block_size=16,
+                        physical_hbm_capacity_bytes=capacity_gib * 1024**3,
+                        target_pressure=target,
+                        runtime_overhead_bytes=8 * 1024**3,
+                    )
+                continue
+            plan = planner.get_hybrid_residency_plan(
+                block_size=16,
+                physical_hbm_capacity_bytes=capacity_gib * 1024**3,
+                target_pressure=target,
+                runtime_overhead_bytes=8 * 1024**3,
+            )
+            assert (
+                plan["unique_resident_footprint_bytes"]
+                + plan["target_rounding_slack_bytes"]
+                == plan["target_footprint_bytes"]
+            )
+            assert plan["target_rounding_slack_bytes"] < (
+                plan["kv_block_stride_bytes"]
+                + plan["block_table_entry_bytes"]
+            )
+            assert plan["unique_resident_footprint_bytes"] == (
+                plan["immutable_weight_backing_bytes"]
+                + plan["runtime_overhead_bytes"]
+                + plan["block_table_bytes"]
+                + plan["logical_kv_bytes"]
+            )
+            assert plan["num_logical_kv_blocks"] == (
+                plan["hot_kv_blocks"] + plan["cold_kv_blocks"]
+            )
+            assert plan["logical_kv_bytes"] == (
+                plan["hot_kv_bytes"] + plan["cold_kv_bytes"]
+            )
+            assert plan["physical_hbm_capacity_bytes"] == (
+                plan["fixed_hbm_bytes"]
+                + plan["hot_kv_bytes"]
+                + plan["unused_hbm_bytes"]
+            )
+            assert plan["fixed_hbm_bytes"] == (
+                plan["runtime_overhead_bytes"]
+                + plan["block_table_bytes"]
+                + plan["active_weight_buffer_bytes"]
+            )
+            assert plan["backing_bytes"] == (
+                plan["immutable_weight_backing_bytes"]
+                + plan["cold_kv_bytes"]
+            )
