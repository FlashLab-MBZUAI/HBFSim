+    def _attention_scale_elements_per_layer(self) -> int:
+        if self._memory_precision.quantization_scheme == "none":
+            return 0
+        q_projection_multiplier = (
+            2 if getattr(self._model_config, "attn_output_gate", False) else 1
+        )
+        return (
+            q_projection_multiplier
+            * int(self._model_config.num_q_heads)
+            * int(self._attention_head_dim)
+            + 2
+            * int(self._model_config.num_kv_heads)
+            * int(self._attention_head_dim)
+            + int(self._model_config.embedding_dim)
+        )
+
+    def _mlp_scale_elements_per_layer(self) -> int:
+        if self._memory_precision.quantization_scheme == "none":
+            return 0
+        up_projection_multiplier = (
+            2 if getattr(self._model_config, "use_gated_mlp", False) else 1
+        )
+        return (
+            up_projection_multiplier * int(self._model_config.mlp_hidden_dim)
+            + int(self._model_config.embedding_dim)
+        )
+
+    def _boundary_scale_elements_per_device(self) -> int:
+        if (
+            self._memory_precision.quantization_scheme == "none"
+            or self._cluster_type == ClusterType.DECODE_FFN
+        ):
+            return 0
+        matrices = 1 + int(
+            not getattr(self._model_config, "tie_word_embeddings", True)
+        )
+        return matrices * int(self._model_config.vocab_size)
+
+    def _weight_memory_category(
+        self,
+        *,
+        parameters: int,
+        matrix_parameters: int,
+        scale_elements: int,
+    ) -> dict[str, int]:
+        if matrix_parameters < 0 or matrix_parameters > parameters:
+            raise ValueError(
+                "matrix parameter count must be within total parameter count"
+            )
+        non_matrix_parameters = parameters - matrix_parameters
+        matrix_payload_bytes = (
+            matrix_parameters * self._memory_precision.matrix_weight_bytes
+        )
+        non_matrix_payload_bytes = (
+            non_matrix_parameters
+            * self._memory_precision.non_matrix_weight_bytes
+        )
+        quantization_metadata_bytes = scale_elements * (
+            self._memory_precision.scale_bytes
+            + self._memory_precision.zero_point_bytes
+        )
+        return {
+            "parameters": int(parameters),
+            "matrix_parameters": int(matrix_parameters),
+            "non_matrix_parameters": int(non_matrix_parameters),
+            "matrix_payload_bytes": int(matrix_payload_bytes),
+            "non_matrix_payload_bytes": int(non_matrix_payload_bytes),
+            "scale_elements": int(scale_elements),
+            "quantization_metadata_bytes": int(
+                quantization_metadata_bytes
+            ),
+            "memory_bytes": int(
+                matrix_payload_bytes
+                + non_matrix_payload_bytes
+                + quantization_metadata_bytes
+            ),
+        }
+
+    def get_weight_memory_ledger_per_device(self) -> dict:
+        self._validate_scaled_memory_profile()
+        num_layers = self._num_layers_per_pipeline_stage
+        attention_parameters = (
+            self.get_num_attention_params_per_layer() * num_layers
+        )
+        attention_matrix_parameters = (
+            self._get_attention_matrix_params_per_layer() * num_layers
+        )
+        ffn_parameters = self.get_num_mlp_parameters_per_device()
+        if getattr(self._model_config, "is_moe", False):
+            ffn_matrix_parameters = ffn_parameters
+        else:
+            ffn_matrix_parameters = (
+                self._get_dense_mlp_matrix_params_per_layer() * num_layers
+            )
+        normalization_parameters = self.get_num_norm_parameters_per_device()
+        boundary_parameters = (
+            self.get_num_boundary_and_auxiliary_parameters_per_device()
+        )
+        categories = {
+            "attention": self._weight_memory_category(
+                parameters=attention_parameters,
+                matrix_parameters=attention_matrix_parameters,
+                scale_elements=(
+                    self._attention_scale_elements_per_layer() * num_layers
+                ),
+            ),
+            "ffn": self._weight_memory_category(
+                parameters=ffn_parameters,
+                matrix_parameters=ffn_matrix_parameters,
+                scale_elements=(
+                    self._mlp_scale_elements_per_layer() * num_layers
+                ),
+            ),
+            "normalization": self._weight_memory_category(
+                parameters=normalization_parameters,
+                matrix_parameters=0,
+                scale_elements=0,
+            ),
+            "pipeline_boundary_and_auxiliary": self._weight_memory_category(
+                parameters=boundary_parameters,
+                matrix_parameters=self._get_boundary_matrix_params_per_device(),
+                scale_elements=self._boundary_scale_elements_per_device(),
+            ),
+        }
+        total_parameters = sum(
+            category["parameters"] for category in categories.values()
+        )
+        expected_parameters = self.get_num_parameters_per_device()
+        if total_parameters != expected_parameters:
+            raise ValueError(
+                "weight-memory ledger parameter conservation failed: "
+                f"categories={total_parameters}, expected={expected_parameters}"
+            )
+        total_memory_bytes = sum(
+            category["memory_bytes"] for category in categories.values()
+        )
+        return {
+            "profile": self._memory_precision.to_dict(),
+            "total_parameters": int(total_parameters),
+            "total_memory_bytes": int(total_memory_bytes),
+            "matrix_payload_bytes": int(
+                sum(
+                    category["matrix_payload_bytes"]
+                    for category in categories.values()
+                )
+            ),
+            "non_matrix_payload_bytes": int(
+                sum(
+                    category["non_matrix_payload_bytes"]
+                    for category in categories.values()
+                )
+            ),
+            "quantization_metadata_bytes": int(
+                sum(
+                    category["quantization_metadata_bytes"]
+                    for category in categories.values()
+                )
+            ),
+            "categories": categories,
+        }
