+def _manager(*, num_blocks: int = 2) -> KVCacheManager:
+    return KVCacheManager(
+        block_size=2,
+        num_gpu_blocks=num_blocks,
+        enable_caching=True,
+        caching_hash_algo="builtin",
+        num_preallocate_tokens=0,
+        lifecycle_stream_id="monolithic:replica-0:dp-0",
+    )
+
+
+def _request(
+    block_hash: int,
+    *,
+    num_prefill_tokens: int = 2,
+    extra_block_hashes: list[int] | None = None,
+) -> Request:
+    return Request(
+        arrived_at=0.0,
+        num_prefill_tokens=num_prefill_tokens,
+        num_decode_tokens=1,
+        block_hash_ids=[block_hash, *(extra_block_hashes or [])],
+    )
+
+
+def _admit_full_block(
+    manager: KVCacheManager,
+    request: Request,
+    *,
+    event_time: float,
+) -> None:
+    computed_blocks, _ = manager.get_computed_blocks(
+        request,
+        event_time=event_time,
+    )
+    num_cached_tokens = len(computed_blocks) * manager.block_size
+    if num_cached_tokens == request.num_prefill_tokens and computed_blocks:
+        computed_blocks = computed_blocks[:-1]
+        num_cached_tokens -= manager.block_size
+    manager.record_prefix_admission(
+        request,
+        computed_blocks,
+        event_time=event_time,
+    )
+    allocated = manager.allocate_slots(
+        request,
+        request.num_prefill_tokens - num_cached_tokens,
+        new_computed_blocks=computed_blocks,
+        event_time=event_time,
+    )
+    assert allocated is not None
+
+
+def test_kv_lifecycle_records_hit_release_and_physical_block_eviction() -> None:
+    manager = _manager()
+
+    first = _request(101)
+    _admit_full_block(manager, first, event_time=0.0)
+    manager.free(first, event_time=1.0)
+
+    shared = _request(101, num_prefill_tokens=4, extra_block_hashes=[202])
+    _admit_full_block(manager, shared, event_time=2.0)
+    manager.free(shared, event_time=3.0)
+
+    replacement = _request(303)
+    _admit_full_block(manager, replacement, event_time=4.0)
+
+    events = manager.drain_lifecycle_events()
+    assert [event["event_index"] for event in events] == list(range(len(events)))
+    assert [event["event_id"] for event in events] == [
+        f"monolithic:replica-0:dp-0:{index:012d}"
+        for index in range(len(events))
+    ]
+    shared_touch = next(
+        event
+        for event in events
+        if event["event"] == "touch"
+        and event["request_id"] == str(shared.id)
+    )
+    assert shared_touch["blocks"][0]["ref_count_after"] == 1
+    eviction = next(event for event in events if event["event"] == "evict")
+    assert eviction["evicted_block_hash"] == 202
+
