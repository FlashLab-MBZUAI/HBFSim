+            * int(self._model_config.embedding_dim)
+        )
+        output_head_parameters = (
+            0
+            if getattr(self._model_config, "tie_word_embeddings", True)
+            else self._get_vocab_matrix_params_per_device()
+        )
+        last_stage_parameters = (
+            final_norm_parameters
+            + output_head_parameters
