+            return embedding_parameters + last_stage_parameters
+        return max(embedding_parameters, last_stage_parameters)
+
+    def _get_boundary_matrix_params_per_device(self) -> int:
+        if self._cluster_type == ClusterType.DECODE_FFN:
+            return 0
+        embedding_parameters = self._get_vocab_matrix_params_per_device()
+        output_head_parameters = (
+            0
+            if getattr(self._model_config, "tie_word_embeddings", True)
+            else embedding_parameters
+        )
+        final_norm_parameters = (
+            self._get_norm_parameter_multiplier()
+            * int(self._model_config.embedding_dim)
+        )
+        mtp_parameters = self.get_num_mtp_parameters_per_device()
+        if int(self._replica_config.num_pipeline_stages) == 1:
+            return embedding_parameters + output_head_parameters
+        first_stage_parameters = embedding_parameters
+        last_stage_parameters = (
+            final_norm_parameters + output_head_parameters + mtp_parameters
+        )
+        return (
+            embedding_parameters
+            if first_stage_parameters >= last_stage_parameters
+            else output_head_parameters
         )
 
+    def _validate_scaled_memory_profile(self) -> None:
+        if self._memory_precision.quantization_scheme == "none":
+            return
+        if getattr(self._model_config, "is_moe", False):
+            raise ValueError(
+                "scaled memory precision currently supports dense models only"
+            )
+        if self._cluster_type != ClusterType.MONOLITHIC:
+            raise ValueError(
+                "scaled memory precision currently requires MONOLITHIC mode"
+            )
+        if (
+            int(self._replica_config.num_pipeline_stages) != 1
+            or self._get_attn_tp_size() != 1
+            or self._get_moe_tp_size() != 1
+            or self._get_ep_size() != 1
+        ):
+            raise ValueError(
+                "scaled memory precision currently requires PP=TP=EP=1"
+            )
+        if self.get_num_mtp_parameters_per_device() != 0:
+            raise ValueError(
+                "scaled memory precision does not yet support MTP parameters"
+            )
