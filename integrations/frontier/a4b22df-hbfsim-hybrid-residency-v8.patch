@@ -0,0 +1,50 @@
+"""Compact immutable contract between Frontier's KV allocator and HBFSim."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from typing import Any, Iterable, Mapping
+
+
+MEMORY_CONTRACT_SCHEMA_VERSION = 4
+ALLOCATOR_STATE_SCHEMA_VERSION = 1
+RESIDENCY_PLAN_SCHEMA_VERSION = 1
+INTEGRATION_ID = "hbfsim.frontier-hybrid-residency.v8"
+UPSTREAM_REVISION = "a4b22df8211864bf229258ecdfbe680f048f2d77"
+
+
+def canonical_allocator_state(
+    request_id: str,
+    blocks: Iterable[Mapping[str, Any]],
+) -> dict[str, Any]:
+    normalized_blocks = [
+        {
+            "block_id": int(block["block_id"]),
+            "block_hash": (
+                None
+                if block.get("block_hash") is None
+                else int(block["block_hash"])
+            ),
+            "ref_count": int(block["ref_count"]),
+        }
+        for block in blocks
+    ]
+    return {
+        "schema_version": ALLOCATOR_STATE_SCHEMA_VERSION,
+        "request_id": str(request_id),
+        "blocks": normalized_blocks,
+    }
+
+
+def allocator_state_sha256(
+    request_id: str,
+    blocks: Iterable[Mapping[str, Any]],
+) -> str:
+    encoded = json.dumps(
+        canonical_allocator_state(request_id, blocks),
+        sort_keys=True,
+        separators=(",", ":"),
+        allow_nan=False,
+    ).encode("utf-8")
+    return hashlib.sha256(encoded).hexdigest()
