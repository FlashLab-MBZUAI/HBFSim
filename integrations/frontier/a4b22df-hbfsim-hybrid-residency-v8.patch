+    def get_dense_weight_streaming_ledger_per_device(self) -> dict:
+        """Return exact immutable objects used by hybrid layer streaming.
+
+        HBFSim's canonical Frontier path currently supports one dense,
+        monolithic PP=TP=EP=1 replica.  Under that contract, immutable weights
+        live in the backing tier and two HBM slots each hold the largest
+        executable weight object: embedding, one transformer layer, final
+        normalization, or the output head.
+        """
+        self._validate_scaled_memory_profile()
+        if self._cluster_type != ClusterType.MONOLITHIC:
+            raise ValueError(
+                "dense weight streaming requires MONOLITHIC cluster type"
+            )
+        if getattr(self._model_config, "is_moe", False):
+            raise ValueError("dense weight streaming does not support MoE")
+        if (
+            int(self._replica_config.num_pipeline_stages) != 1
+            or self._get_attn_tp_size() != 1
+            or self._get_moe_tp_size() != 1
+            or self._get_ep_size() != 1
+        ):
+            raise ValueError(
+                "dense weight streaming currently requires PP=TP=EP=1"
+            )
+
+        def add_categories(*categories: dict[str, int]) -> dict[str, int]:
+            fields = (
+                "parameters",
+                "matrix_parameters",
+                "non_matrix_parameters",
+                "matrix_payload_bytes",
+                "non_matrix_payload_bytes",
+                "scale_elements",
+                "quantization_metadata_bytes",
+                "memory_bytes",
+            )
+            return {
+                field: int(sum(category[field] for category in categories))
+                for field in fields
+            }
+
+        attention = self._weight_memory_category(
+            parameters=self.get_num_attention_params_per_layer(),
+            matrix_parameters=self._get_attention_matrix_params_per_layer(),
+            scale_elements=self._attention_scale_elements_per_layer(),
+        )
+        ffn = self._weight_memory_category(
+            parameters=self.get_num_mlp_params_per_layer(),
+            matrix_parameters=self._get_dense_mlp_matrix_params_per_layer(),
+            scale_elements=self._mlp_scale_elements_per_layer(),
+        )
+        normalization = self._weight_memory_category(
+            parameters=self.get_num_norm_params_per_layer(),
+            matrix_parameters=0,
+            scale_elements=0,
+        )
+        transformer_layer = add_categories(
+            attention,
+            ffn,
+            normalization,
+        )
+
+        vocabulary_matrix_parameters = (
+            self._get_vocab_matrix_params_per_device()
+        )
+        vocabulary_scale_elements = (
+            0
+            if self._memory_precision.quantization_scheme == "none"
+            else int(self._model_config.vocab_size)
+        )
+        embedding = self._weight_memory_category(
+            parameters=vocabulary_matrix_parameters,
+            matrix_parameters=vocabulary_matrix_parameters,
+            scale_elements=vocabulary_scale_elements,
+        )
+        tied_embeddings = bool(
+            getattr(self._model_config, "tie_word_embeddings", True)
+        )
+        output_head = self._weight_memory_category(
+            parameters=(
+                0 if tied_embeddings else vocabulary_matrix_parameters
+            ),
+            matrix_parameters=(
+                0 if tied_embeddings else vocabulary_matrix_parameters
+            ),
+            scale_elements=(
+                0 if tied_embeddings else vocabulary_scale_elements
+            ),
+        )
+        final_norm_parameters = (
+            self._get_norm_parameter_multiplier()
+            * int(self._model_config.embedding_dim)
+        )
+        final_norm = self._weight_memory_category(
+            parameters=final_norm_parameters,
+            matrix_parameters=0,
+            scale_elements=0,
+        )
+        objects = {
+            "embedding": embedding,
+            "transformer_layer": transformer_layer,
+            "final_norm": final_norm,
+            "output_head": output_head,
+        }
+        num_layers = int(self._model_config.num_layers)
+        reconstructed_weight_bytes = (
+            embedding["memory_bytes"]
+            + num_layers * transformer_layer["memory_bytes"]
+            + final_norm["memory_bytes"]
+            + output_head["memory_bytes"]
+        )
+        reconstructed_parameters = (
+            embedding["parameters"]
+            + num_layers * transformer_layer["parameters"]
