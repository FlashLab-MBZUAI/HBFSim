+@dataclass(frozen=True)
+class MemoryPrecisionConfig:
+    """Exact parameter/KV storage contract, independent of compute timing."""
+
+    profile_id: str
+    matrix_weight_dtype: str
+    matrix_weight_bytes: int
+    non_matrix_weight_dtype: str
+    non_matrix_weight_bytes: int
+    kv_dtype: str
+    kv_bytes: int
+    activation_dtype: str
+    activation_bytes: int
+    quantization_scheme: str
+    scale_dtype: Optional[str]
+    scale_bytes: int
+    zero_point_bytes: int
+    claim_scope: str
+
+    @staticmethod
+    def _validate_dtype_bytes(dtype: str, byte_count: int, path: str) -> None:
+        precision = PrecisionType.from_string(dtype)
+        expected = precision.bytes_per_element
+        if not expected.is_integer() or int(expected) != int(byte_count):
+            raise ValueError(
+                f"{path} dtype/bytes mismatch: dtype={dtype!r}, "
+                f"bytes={byte_count!r}, expected={expected!r}"
+            )
+
+    def __post_init__(self) -> None:
+        if not self.profile_id:
+            raise ValueError("memory precision profile_id must be non-empty")
+        for path, dtype, byte_count in (
+            (
+                "matrix_weight",
+                self.matrix_weight_dtype,
+                self.matrix_weight_bytes,
+            ),
+            (
+                "non_matrix_weight",
+                self.non_matrix_weight_dtype,
+                self.non_matrix_weight_bytes,
+            ),
+            ("kv", self.kv_dtype, self.kv_bytes),
+            ("activation", self.activation_dtype, self.activation_bytes),
+        ):
+            if byte_count <= 0:
+                raise ValueError(f"{path}_bytes must be positive")
+            self._validate_dtype_bytes(dtype, byte_count, path)
+        if self.zero_point_bytes != 0:
+            raise ValueError(
+                "only symmetric weight storage with zero_point_bytes=0 is supported"
+            )
+        if self.quantization_scheme == "none":
+            if self.scale_dtype is not None or self.scale_bytes != 0:
+                raise ValueError(
+                    "quantization_scheme='none' requires no scale storage"
+                )
+        elif self.quantization_scheme == "symmetric_per_output_channel":
+            if self.scale_dtype is None or self.scale_bytes <= 0:
+                raise ValueError(
+                    "symmetric_per_output_channel requires a scale dtype/bytes"
+                )
+            self._validate_dtype_bytes(
+                self.scale_dtype,
+                self.scale_bytes,
+                "scale",
+            )
+        else:
+            raise ValueError(
+                "quantization_scheme must be 'none' or "
+                "'symmetric_per_output_channel'"
+            )
+        if self.claim_scope != "memory_storage_and_traffic_only":
+            raise ValueError(
+                "memory precision claim_scope must be "
+                "'memory_storage_and_traffic_only'"
+            )
+
+    @classmethod
+    def from_dict(
+        cls,
+        profile_id: str,
+        payload: Dict[str, Any],
+    ) -> "MemoryPrecisionConfig":
+        expected = {
+            "matrix_weight_dtype",
+            "matrix_weight_bytes",
+            "non_matrix_weight_dtype",
+            "non_matrix_weight_bytes",
+            "kv_dtype",
+            "kv_bytes",
+            "activation_dtype",
+            "activation_bytes",
+            "quantization_scheme",
+            "scale_dtype",
+            "scale_bytes",
+            "zero_point_bytes",
+            "claim_scope",
+        }
+        if set(payload) != expected:
+            raise ValueError(
+                f"memory precision profile {profile_id!r} keys mismatch: "
+                f"missing={sorted(expected - set(payload))}, "
+                f"extra={sorted(set(payload) - expected)}"
+            )
+        return cls(profile_id=profile_id, **payload)
+
+    @classmethod
+    def native(cls, torch_dtype: str) -> "MemoryPrecisionConfig":
+        precision = PrecisionType.from_torch_dtype(torch_dtype)
+        byte_count = precision.bytes_per_element
+        if not byte_count.is_integer():
+            raise ValueError(
+                "native model memory precision requires whole-byte storage"
+            )
+        dtype = precision.value
+        return cls(
+            profile_id=f"native-{dtype}-kv-{dtype}",
+            matrix_weight_dtype=dtype,
+            matrix_weight_bytes=int(byte_count),
+            non_matrix_weight_dtype=dtype,
+            non_matrix_weight_bytes=int(byte_count),
+            kv_dtype=dtype,
+            kv_bytes=int(byte_count),
+            activation_dtype=dtype,
+            activation_bytes=int(byte_count),
+            quantization_scheme="none",
+            scale_dtype=None,
+            scale_bytes=0,
+            zero_point_bytes=0,
+            claim_scope="memory_storage_and_traffic_only",
+        )
+
+    def to_dict(self) -> Dict[str, Any]:
+        return {
+            "profile_id": self.profile_id,
+            "matrix_weight_dtype": self.matrix_weight_dtype,
+            "matrix_weight_bytes": self.matrix_weight_bytes,
+            "non_matrix_weight_dtype": self.non_matrix_weight_dtype,
+            "non_matrix_weight_bytes": self.non_matrix_weight_bytes,
+            "kv_dtype": self.kv_dtype,
+            "kv_bytes": self.kv_bytes,
+            "activation_dtype": self.activation_dtype,
+            "activation_bytes": self.activation_bytes,
+            "quantization_scheme": self.quantization_scheme,
+            "scale_dtype": self.scale_dtype,
+            "scale_bytes": self.scale_bytes,
+            "zero_point_bytes": self.zero_point_bytes,
+            "claim_scope": self.claim_scope,
+        }
+
