  "case_id": "hbm.dual-pch-overlap",
  "model": "hbm",
  "notes": [
    "The two requests target different lanes of one service group: with the 64 B interleave, addr 0 decodes to pseudochannel 0 and addr 64 to pseudochannel 1, so the summary reports active_pseudo_channels=2 while the two independent transfers still serialize on the group's shared data calendar (the second waits for the first's quantum)."
  ],
  "comparison": {
    "time_abs_tolerance_ns": 1e-09,
    "time_rel_tolerance": 1e-12
  },
  "config": {
    "capacity_bytes": 128,
    "stacks": 1,
    "channels_per_stack": 1,
    "pseudo_channels_per_channel": 2,
    "bank_groups_per_pseudo_channel": 1,
    "banks_per_group": 1,
    "channel_row_size_bytes": 128
  },
  "inspect_addresses": [
    0,
    64
  ],
  "requests": [
    {
      "id": "pch0",
      "arrival_ns": 0.0,
      "op": "read",
      "address_space": "logical",
      "addr": 0,
      "bytes": 32
    },
    {
      "id": "pch1",
      "arrival_ns": 0.0,
      "op": "read",
      "address_space": "logical",
      "addr": 64,
      "bytes": 32
    }
  ]
