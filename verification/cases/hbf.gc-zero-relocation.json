{
  "schema": {
    "name": "hbfsim.verification.case",
    "version": 1
  },
  "case_id": "hbf.gc-zero-relocation",
  "model": "hbf",
  "notes": [
    "Each logical access first pays mapping_control_compute_ns as mapping_lookup_compute on the shared host compute pool (one worker per stack; equal starts prefer the most recently freed worker, idle since no earlier than the request arrival), then one ctrl_dram_issue_ns issue on host/mapping/partition{stack} whose entry transfer shares the HBM service-group calendars (hbm/group{N}).",
    "A mapping update pays mapping_update_compute before its metadata access and then publishes for mapping_update_ns as mapping_publish_compute on the same host compute pool; user and GC updates share that stage, so the reducer counts GC updates as relocated data pages.",
    "Zero-live victims relocate nothing, so no GC mapping update is published."
  ],
  "comparison": {
    "time_abs_tolerance_ns": 1e-09,
    "time_rel_tolerance": 1e-12
  },
  "config": {
    "stacks": 1,
    "channels_per_stack": 1,
    "dies_per_channel": 1,
    "planes_per_die": 1,
    "blocks_per_plane": 8,
    "pages_per_block": 2,
    "page_size_bytes": 4096,
    "oob_bytes_per_page": 128,
    "media_lanes_per_plane": 1,
    "page_buffer_banks_per_plane": 1,
    "mapping_entries_per_page": 512,
    "auto_gc_enabled": true,
    "gc_reserved_free_blocks_per_plane": 1
  },
