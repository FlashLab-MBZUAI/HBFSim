{
  "name": "HBFSim",
  "image": "mcr.microsoft.com/devcontainers/cpp:1-ubuntu-24.04",
  "postCreateCommand": "python3 -m hbfsim build && python3 -m hbfsim doctor",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools",
        "ms-python.python"
      ],
      "settings": {
        "cmake.useCMakePresets": "always"
      }
    }
  }
}
